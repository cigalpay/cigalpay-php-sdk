{
    "name": "cigalpay/cigalpay-php-sdk",
    "description": "Official CigalPay PHP SDK: accept crypto payments (BTC, ETH, USDT, SOL and more) in your app, SaaS or website.",
    "type": "library",
    "keywords": ["cigalpay", "crypto", "payments", "bitcoin", "usdt", "payment-gateway", "webhook"],
    "homepage": "https://cigalpay.com/developers",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Cigalpay\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "support": {
        "email": "support@cigalpay.com",
        "docs": "https://cigalpay.com/developers"
    },
    "authors": [
        {
            "name": "CigalPay",
            "email": "support@cigalpay.com"
        }
    ]
}
